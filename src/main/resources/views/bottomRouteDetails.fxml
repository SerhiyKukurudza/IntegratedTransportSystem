<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="paneBottomRouteDetails"
      styleClass="bottom-feature-pane">
    <stylesheets>
        <URL value="@styles/bottomDetails.css"/>
    </stylesheets>
    <VBox prefWidth="%map.width" styleClass="bottom-main-container, bottom-feature-pane" prefHeight="%bottom.height">
        <HBox>
            <Label text="%bottom.bottomRouteDetails.title" styleClass="bottom-container-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="buttonClose" styleClass="close-button" maxWidth="%bottomDetails.closeButton.maxWidth">
                <graphic>
                    <FontIcon iconLiteral="mdi-close" styleClass="close-icon"/>
                </graphic>
            </Button>
        </HBox>
        <HBox styleClass="bottom-box" fx:id="hBoxRouteInfo">
            <VBox>
                <Label text="%bottom.bottomRouteDetails.table.title" styleClass="bottom-free-subtitle"/>
                <GridPane styleClass="bottom-grid-gap">
                    <Label styleClass="bottom-grid-header" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           text="%bottom.bottomRouteDetails.table.row1"/>
                    <Label styleClass="bottom-grid-header" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           text="%bottom.bottomRouteDetails.table.row2"/>
                    <Label styleClass="bottom-grid-header" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           text="%bottom.bottomRouteDetails.table.row3"/>
                    <Label styleClass="bottom-grid-header" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           text="%bottom.bottomRouteDetails.table.row4"/>
                    <Label styleClass="bottom-grid-header" GridPane.rowIndex="4" GridPane.columnIndex="0"
                           text="%bottom.bottomRouteDetails.table.row5"/>
                    <ScrollPane fx:id="scrollBottomPaneRouteDetails" styleClass="bottom-scroll-pane-border"
                                GridPane.rowIndex="0" GridPane.rowSpan="6"
                                GridPane.columnIndex="1" maxWidth="%findStopsBottom.table.maxWidth">
                        <GridPane fx:id="gridBottomPaneRouteDetails"
                                  styleClass="bottom-grid-text-scroll-pane, bottom-grid-gap"/>
                    </ScrollPane>
                </GridPane>
            </VBox>

            <VBox styleClass="bottom-table-container">
                <Label text="%bottom.bottomRouteDetails.firstStop.title"
                       styleClass="bottom-subtitle, tab-before-spacing"/>
                <GridPane styleClass="bottom-grid-gap">
                    <Label text="%bottom.bottomStopDetails.stopName" styleClass="bottom-details-text"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelFirstStopName" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="%bottom.bottomStopDetails.stopNumberConnections" styleClass="bottom-details-text"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelFirstStopConnections" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="%bottom.bottomStopDetails.stopLongitude" styleClass="bottom-details-text"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelFirstStopLongitude" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="%bottom.bottomStopDetails.stopLatitude" styleClass="bottom-details-text"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelFirstStopLatitude" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <VBox>
                <Label text="%bottom.bottomRouteDetails.secondStop.title"
                       styleClass="bottom-subtitle, tab-before-spacing"/>
                <GridPane styleClass="bottom-grid-gap">
                    <Label text="%bottom.bottomStopDetails.stopName" styleClass="bottom-details-text"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelSecondStopName" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="%bottom.bottomStopDetails.stopNumberConnections" styleClass="bottom-details-text"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelSecondStopConnections"
                           styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="%bottom.bottomStopDetails.stopLongitude" styleClass="bottom-details-text"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelSecondStopLongitude" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="%bottom.bottomStopDetails.stopLatitude" styleClass="bottom-details-text"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelSecondStopLatitude" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>
        </HBox>
    </VBox>
</Pane>
