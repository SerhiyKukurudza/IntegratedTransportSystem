<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="tabCalculateRoutePane"
      prefHeight="%screen.height" styleClass="tab-feature-pane">
    <VBox styleClass="tab-main-container" prefWidth="%tabPane.content.width">
        <Label text="%tab.calculateRoute.title" styleClass="tab-title"/>

        <VBox styleClass="tab-secondary-container">
            <Label text="%tab.calculateRoute.stops.stopTitle" styleClass="tab-subtitle"/>
            <VBox>
                <Label text="%tab.calculateRoute.stops.startingStop" styleClass="tab-text"/>
                <ComboBox fx:id="comboBoxOriginStop" promptText="%tab.calculateRoute.stops.comboBoxLabel" styleClass="tab-input-sizing"/>
            </VBox>

            <VBox>
                <Label text="%tab.calculateRoute.stops.destinationStop" styleClass="tab-text"/>
                <ComboBox fx:id="comboBoxDestinationStop" promptText="%tab.calculateRoute.stops.comboBoxLabel" styleClass="tab-input-sizing"/>
            </VBox>
        </VBox>

        <VBox styleClass="tab-secondary-container">
            <Label text="%tab.calculateRoute.cost.costTitle" styleClass="tab-subtitle"/>
            <VBox>
                <Label text="%tab.calculateRoute.cost.preferredCost" styleClass="tab-text"/>
                <ComboBox fx:id="comboBoxPreferredCost" promptText="%tab.calculateRoute.cost.comboBoxLabel" styleClass="tab-input-sizing"/>
            </VBox>
        </VBox>

        <VBox styleClass="tab-secondary-container">
            <Label text="%tab.calculateRoute.transports.transportsTitle" styleClass="tab-subtitle"/>
            <VBox fx:id="vBoxUsableTransports">
            </VBox>
        </VBox>

        <Button fx:id="buttonFindShortestPath" text="%tab.calculateRoute.findShortestPath" styleClass="tab-button"/>
    </VBox>
</Pane>
