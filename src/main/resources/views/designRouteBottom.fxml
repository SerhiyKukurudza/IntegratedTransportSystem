<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="bottomDesignRoutePane"
      styleClass="bottom-feature-pane">
    <VBox fx:id="vBoxTips" prefWidth="%map.width" styleClass="bottom-main-container">
        <Label text="%bottom.designRoute.title" styleClass="bottom-container-title"/>
        <HBox styleClass="bottom-box">
            <VBox styleClass="bottom-childBox">
                <Label text="%bottom.designRoute.first.title" styleClass="bottom-subtitle"/>
                <Label text="%bottom.designRoute.first.label" styleClass="bottom-text"/>
            </VBox>
            <VBox styleClass="bottom-childBox">
                <Label text="%bottom.designRoute.second.title" styleClass="bottom-subtitle"/>
                <Label text="%bottom.designRoute.second.label" styleClass="bottom-text"/>
            </VBox>
            <VBox styleClass="bottom-childBox">
                <Label text="%bottom.designRoute.third.title" styleClass="bottom-subtitle"/>
                <Label text="%bottom.designRoute.third.label" styleClass="bottom-text"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="vBoxDesigningRoute" prefWidth="%map.width" styleClass="bottom-main-container">
        <HBox>
            <Label text="%bottom.designRoute.designed.title" styleClass="bottom-container-title"/>
            <Label text="X" fx:id="labelFirstStopName" styleClass="bottom-container-title" />
        </HBox>

        <HBox styleClass="bottom-box" fx:id="hBoxRouteInfo">
            <VBox>
                <Label text="%bottom.designRoute.designed.currentCost" styleClass="bottom-subtitle, tab-before-spacing"/>

                <GridPane styleClass="bottom-grid-gap">
                    <Label text="%bottom.designRoute.designed.distance" styleClass="bottom-text"
                           GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label text="X" fx:id="labelDistance" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="%bottom.designRoute.designed.duration" styleClass="bottom-text"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label text="X" fx:id="labelDuration" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <HBox GridPane.rowIndex="2" GridPane.columnIndex="0" >
                        <FontIcon iconLiteral="mdi-leaf" fill="forestgreen" iconSize="16" />
                        <Label text="%bottom.designRoute.designed.cost" styleClass="bottom-text" />
                    </HBox>
                    <Label text="X" fx:id="labelCost" styleClass="bottom-details-text, bottom-bold-text"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <VBox>
                <Label text="%bottom.designRoute.designed.table.title" styleClass="bottom-subtitle, tab-before-spacing"/>

                <GridPane styleClass="bottom-grid-gap">
                    <Label styleClass="bottom-grid-header" GridPane.rowIndex="0" GridPane.columnIndex="0" text="%bottom.designRoute.designed.table.row1" />
                    <Label styleClass="bottom-grid-header" GridPane.rowIndex="1" GridPane.columnIndex="0" text="%bottom.designRoute.designed.table.row2" />
                    <Label styleClass="bottom-grid-header" GridPane.rowIndex="2" GridPane.columnIndex="0" text="%bottom.designRoute.designed.table.row3" />
                    <ScrollPane fx:id="scrollBottomPaneDesignRouteDetails" styleClass="bottom-scroll-pane-border"
                                GridPane.rowIndex="0" GridPane.rowSpan="5"
                                GridPane.columnIndex="1" maxWidth="%designRouteBottom.table.width">
                        <GridPane fx:id="gridBottomPaneDesignRouteDetails" styleClass="bottom-grid-text-scroll-pane, bottom-grid-gap" />
                    </ScrollPane>
                </GridPane>
            </VBox>
        </HBox>
    </VBox>
</Pane>