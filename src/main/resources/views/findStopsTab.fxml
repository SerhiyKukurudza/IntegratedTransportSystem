<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="tabFindStopsPane"
      prefHeight="%screen.height" styleClass="tab-feature-pane">
    <VBox styleClass="tab-main-container" prefWidth="%tabPane.content.width">
        <Label text="%tab.find.title" styleClass="tab-title"/>

        <VBox styleClass="tab-secondary-container">
            <Label text="%tab.findStops.stops.title" styleClass="tab-subtitle"/>

            <VBox>
                <Label text="%tab.findStops.stops.label1" styleClass="tab-text"/>
                <ComboBox fx:id="comboBoxOriginStop" promptText="%tab.findStops.stops.comboBoxLabel" styleClass="tab-input-sizing"/>
            </VBox>

            <VBox styleClass="tab-before-button">
                <Label text="%tab.findStops.stops.label2" styleClass="tab-text"/>
                <TextField fx:id="textFieldNumberOfStops" promptText="%tab.findStops.stops.textFieldPrompt" styleClass="tab-input-sizing"/>
            </VBox>

            <Button fx:id="buttonFindStops" text="%tab.findStops.stops.buttonText" styleClass="tab-button"/>
        </VBox>
    </VBox>
</Pane>
