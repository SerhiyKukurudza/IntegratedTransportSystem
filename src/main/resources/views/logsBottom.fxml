<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="bottomLogsPane"
      styleClass="bottom-feature-pane">
    <VBox prefWidth="1024.0" styleClass="bottom-main-container">

        <VBox fx:id="vBoxTips" prefWidth="%map.width" styleClass="bottom-main-container">
            <Label text="%bottom.logs.title" styleClass="bottom-container-title"/>

            <HBox styleClass="bottom-box">
                <VBox styleClass="bottom-childBox">
                    <Label text="%bottom.logs.first.title" styleClass="bottom-subtitle"/>
                    <Label text="%bottom.logs.first.label" styleClass="bottom-text"/>
                </VBox>
                <VBox styleClass="bottom-childBox">
                    <Label text="%bottom.logs.second.title" styleClass="bottom-subtitle"/>
                    <Label text="%bottom.logs.second.label" styleClass="bottom-text"/>
                </VBox>
                <VBox styleClass="bottom-childBox">
                    <Label text="%bottom.logs.third.title" styleClass="bottom-subtitle"/>
                    <Label text="%bottom.logs.third.label" styleClass="bottom-text"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox fx:id="vBoxLogs" prefWidth="%map.width" styleClass="bottom-main-container">
            <Label text="%bottom2.logs.title" styleClass="bottom-container-title"/>

            <HBox styleClass="bottom-box">
                <VBox styleClass="bottom-childBox">
                    <Label text="%bottom2.logs.date" styleClass="bottom-subtitle" />
                    <Label fx:id="labelUserActionDate" styleClass="bottom-text" />
                </VBox>

                <VBox styleClass="bottom-childBox">
                    <Label text="%bottom2.logs.command" styleClass="bottom-subtitle" />
                    <Label fx:id="labelUserActionCommand" styleClass="bottom-text" />
                </VBox>

                <VBox styleClass="bottom-childBox">
                    <Label text="%bottom2.logs.commandDetail" styleClass="bottom-subtitle" />
                    <Label fx:id="labelUserActionCommandDetails" styleClass="bottom-text" />
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</Pane>