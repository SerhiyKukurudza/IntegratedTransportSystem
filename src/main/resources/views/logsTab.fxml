<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="tabLogsPane"
      prefHeight="%screen.height" styleClass="tab-feature-pane">
    <VBox styleClass="tab-main-container" prefWidth="%tabPane.content.width">
        <Label text="%tab.logs.title" styleClass="tab-title" />

        <Label text="%tab.logs.commands" styleClass="tab-subtitle" />
        <ListView fx:id="listViewCommandList" styleClass="tab-secondary-container" prefHeight="%logsTab.listView.height" />
    </VBox>
</Pane>
