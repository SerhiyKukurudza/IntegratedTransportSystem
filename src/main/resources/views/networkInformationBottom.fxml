<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="bottomNetworkInformationPane"
      styleClass="bottom-feature-pane">
    <VBox prefWidth="1024.0" styleClass="bottom-main-container">
        <Label text="%bottom.networkInformation.title" styleClass="bottom-container-title"/>
        <HBox styleClass="bottom-box">
            <VBox styleClass="bottom-childBox">
                <Label text="%bottom.networkInformation.first.title" styleClass="bottom-subtitle"/>
                <Label text="%bottom.networkInformation.first.content" styleClass="bottom-text"/>
            </VBox>
            <VBox styleClass="bottom-childBox">
                <Label text="%bottom.networkInformation.second.title" styleClass="bottom-subtitle"/>
                <Label text="%bottom.networkInformation.second.content" styleClass="bottom-text"/>
            </VBox>
            <VBox styleClass="bottom-childBox">
                <Label text="%bottom.networkInformation.third.title" styleClass="bottom-subtitle"/>
                <Label text="%bottom.networkInformation.third.content" styleClass="bottom-text"/>
            </VBox>
        </HBox>
    </VBox>
</Pane>